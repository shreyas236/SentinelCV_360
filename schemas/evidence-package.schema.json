{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "report_id",
    "created_at",
    "files",
    "key_id",
    "public_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "key_id": {
      "type": "string"
    },
    "public_key": {
      "type": "string"
    }
  }
}
