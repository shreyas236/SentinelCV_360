FROM node:24-bookworm-slim AS frontend
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN npm install -g pnpm@11.25.0 && pnpm install --frozen-lockfile
COPY . .
RUN npm run build:local
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY local/requirements*.txt ./local/
RUN pip install --no-cache-dir -r local/requirements.txt -r local/requirements-stack.txt
COPY --from=frontend /app /app
RUN useradd -m -u 1000 sentinel && mkdir -p /app/local-data && chown -R sentinel:sentinel /app/local-data
USER sentinel
ENV SENTINEL_DATA_DIR=/app/local-data PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn","local.api:app","--host","0.0.0.0","--port","8000","--proxy-headers","--forwarded-allow-ips","*"]
